{
  "name": "radaz-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node verify.mjs",
    "build": "node scripts/build-cloud.mjs",
    "dev:cloud": "wrangler dev --config wrangler.jsonc --local --port 5186",
    "db:generate": "drizzle-kit generate",
    "test:cloud": "node --test tests/cloud.test.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "wrangler": "^4.92.0"
  }
}
