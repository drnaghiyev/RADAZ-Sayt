{
  "name": "radaz-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node scripts/local-server.mjs",
    "dev": "node scripts/local-server.mjs",
    "setup": "npm ci",
    "test": "node --test tests/*.test.mjs",
    "verify": "node verify.mjs",
    "build": "node scripts/build-cloud.mjs",
    "dev:cloud": "wrangler dev --config wrangler.jsonc --local --port 5186",
    "db:generate": "drizzle-kit generate",
    "test:cloud": "node --test tests/cloud.test.mjs",
    "start:legacy": "node --env-file-if-exists=.env server/index.mjs",
    "setup:legacy": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "miniflare": "^4.20260730.0",
    "multer": "^2.4.0",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "esbuild": "^0.28.2",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "^0.35.5",
      "undici": "^7.29.1",
      "ws": "^8.22.0"
    }
  }
}
