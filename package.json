    "test": "node --test tests/*.test.mjs",
    "verify": "node verify.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "sanitize-html": "^2.18.0"
  }
}
