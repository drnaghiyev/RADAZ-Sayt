NODE_ENV=production
HOST=127.0.0.1
PORT=5188
PUBLIC_ORIGIN=https://radaz.example.com
DATA_DIR=./data
# Generate with: npm run setup. Never commit the resulting .env or data directory.
SETTINGS_ENCRYPTION_KEY=
# Only local CLI setup creates the owner account. Public registration cannot create administrators.
OWNER_EMAIL=drnaghiyev@gmail.com
# Web viewer origin/path; blank until the RADAZ receiver has been deployed.
RADAZ_VIEWER_URL=
# Optional installed desktop integration: radaz://open
RADAZ_DESKTOP_ENABLED=false
